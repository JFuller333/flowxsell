# Optional: override GA4 ID (defaults to G-WFT80SQKPP in src/lib/gtag.ts)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Without a key, PSI allows very few runs per day; each funnel snapshot calls PSI twice (mobile + desktop).
# Cloud Console: enable "PageSpeed Insights API", then create an API key under Credentials.
# PAGESPEED_API_KEY=your_google_api_key

# Resend — https://resend.com (create API key + verify sending domain or use onboarding domain for tests)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Must match a verified sender in Resend (e.g. FlowXsell <reports@yourdomain.com>)
RESEND_FROM="FlowXsell <onboarding@resend.dev>"

# Raffle business-card gallery (Supabase: project URL + service role from Settings → API)
# 1) Run api/raffle-setup.sql in Supabase SQL Editor (once).
# 2) Storage → New bucket → name: raffle-cards → Public bucket ON.
# 3) Add these to Vercel (and local .env for npm run dev:full):
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # never expose in frontend or client bundles
# Optional: require header X-Raffle-Secret on POST /api/raffle-upload (server-to-server only; not for browsers)
# RAFFLE_UPLOAD_SECRET=
# Admin-only: POST /api/raffle-delete (header X-Raffle-Admin). Use a long random string; open raffle page once as ?admin=<key> to store in session.
# RAFFLE_ADMIN_KEY=

# ─── /analytics surface (Shopify Analytics & Landing Page Intelligence) ───────
# Without these, /analytics runs on demo data (Tuskegee mock fixtures).
# To swap stores for a live demo: change SHOPIFY_STORE_DOMAIN + SHOPIFY_ADMIN_API_TOKEN, restart npm run dev:full.
#
# How to get the Admin API token:
# 1) Shopify admin → Apps → App and sales channel settings → Develop apps → Create app
# 2) Configuration → Admin API access scopes: enable read_products, read_orders, read_analytics
# 3) Install app → API credentials → copy the Admin API access token (starts with shpat_)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# Anthropic API key — used by /api/generate-landing-page (claude-sonnet-4-6)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
